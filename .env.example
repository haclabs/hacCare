# ============================================================================
# hacCare environment configuration — copy to .env and fill in
# ============================================================================
# Pick ONE of the three blocks below. Never point a local or dev build at the
# production project: the app writes to whatever it is given.
#
# ── 1. LOCAL (supabase start) ───────────────────────────────────────────────
# Run `supabase start`, then `supabase status` and copy the values it prints.
# The anon key for a local stack is fixed per CLI version, so read it from
# `supabase status` rather than pasting one from elsewhere.
#
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<"anon key" from `supabase status`>
#
# ── 2. DEV (hacCare Dev project, dev.haccare.app) ───────────────────────────
#   VITE_SUPABASE_URL=https://<dev-project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<dev project anon/publishable key>
#
# ── 3. PRODUCTION ───────────────────────────────────────────────────────────
# Set in the Netlify UI for the production site only. Do not put production
# credentials in a local .env file.
# ============================================================================

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace_me_from_supabase_status

# Application Configuration
VITE_APP_VERSION=6.0.1
VITE_DEBUG_MODE=false

# Optional: Enable BCMA Debug Mode
VITE_DEBUG_BARCODE=false

# Optional: Security Diagnostics
VITE_ENABLE_SECURITY_DIAGNOSTICS=true
